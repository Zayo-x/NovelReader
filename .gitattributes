# 统一换行符，避免 Windows 提交后 gradlew 在 Unix 上无法执行
* text=auto

*.kt      text
*.kts     text
*.xml     text
*.md      text
*.toml    text
*.properties text
*.pro     text

gradlew   text eol=lf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jar     binary
*.cbz     binary
*.pdf     binary
*.apk     binary
